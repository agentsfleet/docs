.DS_Store
node_modules/
.gstack/

# .claude/ is local to each machine, except what orly manages: its
# orly-* skills and orly-* agents. Wildcards, so a skill a new orly
# release adds is tracked without editing this file.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/orly-*/
!.claude/agents/
.claude/agents/*
!.claude/agents/orly-*.md
